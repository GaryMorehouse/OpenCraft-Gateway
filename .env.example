# Copy this file to .env and adjust values before running docker compose.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# InfluxDB
# Only relevant to the "dev" and "standard" deployment profiles, where
# InfluxDB runs locally via docker compose. See docs/adr/0003-deployment-profiles.md
# ---------------------------------------------------------------------------
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-please
INFLUXDB_INIT_ORG=opencraft
INFLUXDB_INIT_BUCKET=telemetry
# Fixed admin token so Grafana/simulator provisioning can reference a known value.
# Generate a real random token for anything beyond local development.
INFLUXDB_INIT_ADMIN_TOKEN=dev-only-change-me-00000000000000
INFLUXDB_PORT=8086

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# Telemetry publisher (currently the simulator; the future SmartCraft gateway
# publisher uses these same variable names — see docs/adr/0003-deployment-profiles.md)
#
# INFLUXDB_URL is the one setting that changes between deployment profiles:
#   - Development / Standard Vessel: http://influxdb:8086 (colocated container)
#   - Gateway Only (Pi Zero 2 W):    http://<vessel-server-ip>:8086 (remote host)
# ---------------------------------------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=opencraft
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=dev-only-change-me-00000000000000

# Comma-separated propulsion engine instances to simulate/publish.
# Signal K instance naming (port/starboard/center). Adding a second engine
# is changing this value — no code or dashboard changes required.
SIMULATOR_ENGINES=port
SIMULATOR_TICK_SECONDS=1
